{
  "servers": {
    "team-assistant": {
      "command": "node",
      "args": ["/absolute/path/to/microsoft-365/dist/src/index.js"],
      "env": {
        "TEAM_ASSISTANT_TENANT_ID": "",
        "TEAM_ASSISTANT_CLIENT_ID": "",
        "TEAM_ASSISTANT_AUTH_MODE": "device-code",
        "TEAM_ASSISTANT_SCOPES": "",
        "TEAM_ASSISTANT_TOKEN_SERVICE": "team-assistant-mcp"
      }
    }
  }
}
